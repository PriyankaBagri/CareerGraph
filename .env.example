VITE_API_URL=http://localhost:4000/api
# Copy this file to a file named exactly ".env.local" (or ".env") next to package.json, NOT inside server/ (UTF-8, not ".env.txt"), then RESTART `npm run dev`.
# Leaving the value empty does NOT use the backend: set VITE_DEMO_MODE=true (below) for browser-only demo data, otherwise the app shows setup steps.
# When set (it must end in /api), the app uses the real backend (server/) for sign-up/login/logout, careers, skill ratings, evidence and
# readiness/gaps/next actions, profile, target career, custom careers, action progress, settings and the optional AI assistant.
# Browser-only data from older versions stays local until you import it from Settings. Model credentials are NEVER set here: they live in server/.env.

# Optional, explicit demo mode (browser-only data, no server). Only used when VITE_API_URL above is empty. Without either, the app shows setup steps instead of silently using demo data.
# VITE_DEMO_MODE=true
