# Copy to .env and edit. Never commit .env.
PORT=4000
# postgres://USER:PASSWORD@HOST:5432/DATABASE
# Wrap the whole URL in double quotes. An unquoted # cuts the value off, and special characters in the password (@ # / ? : %) must be
# percent-encoded (@ = %40, # = %23, : = %3A, / = %2F, ? = %3F, % = %25). Check with: npm run db:check
DATABASE_URL=postgres://careergraph:CHANGE_ME@localhost:5432/careergraph
# Set to true for managed databases that require TLS.
DATABASE_SSL=false
# Comma-separated list of browser origins allowed to call the API. No wildcards.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# REQUIRED for authentication. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Missing/short in development: auth endpoints answer 503 (server still starts). In production the server refuses to start.
JWT_SECRET=
# Access-token lifetime in seconds (60 .. 2592000). Default 86400 (24 hours). There are no refresh tokens.
JWT_EXPIRES_IN_SECONDS=86400

# --- Optional AI assistant (server-side only; leave AI_PROVIDER empty to run without it) ---
# The key stays in this file on the server. Never put it in the root .env, never prefix it with VITE_, never commit it.
# "anthropic" = Anthropic Messages API. "openai-compatible" = any server that speaks the OpenAI chat-completions format
# (OpenAI itself, or a free local model such as Ollama: AI_BASE_URL=http://localhost:11434/v1 with any non-empty AI_API_KEY).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Required for openai-compatible (must end before /chat/completions, e.g. https://api.openai.com/v1). Optional for anthropic.
AI_BASE_URL=
# Optional limits: request timeout in ms (1000-120000), answer length cap in tokens (50-4000), questions per user per minute (1-120).
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT_PER_MINUTE=10
